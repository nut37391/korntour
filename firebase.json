{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/README.txt"
    ],
    "redirects": [
      {
        "source": "/services",
        "destination": "/programs",
        "type": 301
      },
      {
        "source": "/services/**",
        "destination": "/programs",
        "type": 301
      }
    ]
  }
}
